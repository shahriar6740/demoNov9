<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>QueryDemos</RootNamespace>
    <AssemblyName>QueryDemos</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core 10 (LTS) with the SQL Server provider; also brings Microsoft.Data.SqlClient. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <!-- Design-time support for `dotnet ef` (migrations). PrivateAssets="all" = development-only dependency. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*" PrivateAssets="all" />
  </ItemGroup>

</Project>
